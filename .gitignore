# ==============================================================================
# UTS KEPL - MONOREPO GITIGNORE
# ==============================================================================

# --- Environment & Sensitive Files ---
.env
.env.backup
.env.production
.env.*.local
*.pem
*.key
/roadmap.html

# --- Backend (Laravel) ---
/backend/.env
/backend/.env.*
/backend/vendor/
/backend/storage/*.key
/backend/storage/logs/*
!/backend/storage/logs/.gitignore
/backend/storage/framework/cache/*
!/backend/storage/framework/cache/.gitignore
/backend/storage/framework/sessions/*
!/backend/storage/framework/sessions/.gitignore
/backend/storage/framework/views/*
!/backend/storage/framework/views/.gitignore
/backend/bootstrap/cache/*
!/backend/bootstrap/cache/.gitignore
/backend/.phpunit.result.cache

# --- Frontend (Vue.js 3 / Vite) ---
/frontend/.env
/frontend/.env.local
/frontend/.env.*.local
/frontend/node_modules/
/frontend/dist/
/frontend/dist-ssr/
/frontend/*.local

# --- Logs & Runtime ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editor & OS Specific ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
