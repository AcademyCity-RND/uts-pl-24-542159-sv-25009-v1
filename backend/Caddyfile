{
    # Global options
    frankenphp
    order php_server before file_server
}

:80 {
    root * /app/public
    encode zstd gzip

    # Log format console ke stdout
    log {
        output stdout
        format console
    }

    # Teruskan request /health ke API handler tanpa session middleware
    rewrite /health /api/health

    # Serve file statis langsung
    file_server

    # Eksekusi request Laravel via runtime FrankenPHP
    php_server
}
