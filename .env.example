# ==============================================================================
# UTS KEPL - MONOREPO ENVIRONMENT TEMPLATE (.env.example)
# Salin berkas ini menjadi .env sebelum menjalankan `docker compose up -d`
# ==============================================================================

# --- Pengaturan Aplikasi Backend ---
APP_NAME="UTS-KEPL"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

# --- Port Layanan Docker Host ---
FE_PORT=80
BE_PORT=8000
DB_PORT=3306

# --- Pengaturan Basis Data (MySQL Container) ---
DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=uts_pl
DB_USERNAME=uts_user
DB_PASSWORD=uts_password
DB_ROOT_PASSWORD=root_password

# --- Pengaturan Autentikasi & Cache ---
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Pengaturan Frontend SPA (Vite) ---
# Untuk akses langsung dari peramban ke Backend
VITE_API_URL=http://localhost:8000/api
